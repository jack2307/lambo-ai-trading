/target
# A second build directory, used when the binaries in /target are running.
/target-b
**/*.rs.bk

# Data is fetched, not committed — except the golden files, which are the
# parity oracle for the port and must be version controlled.
/data/*
!/tests/golden
# The scheduled-news calendar is small, hand-verified text: versioned
# (a parent directory that is ignored cannot be re-entered, hence /data/*).
!/data/news/
/data/news/events.parquet

# Python
__pycache__/
*.pyc
.venv/
py/models/*.onnx

# UI
node_modules/
ui/dist/

# Local overrides
config/local.toml

# The runner smoke test leaves receipts nobody needs to keep.
/docs/research/runs/smoke-test/
# Spread samples: raw quotes, megabytes a week, rebuilt by re-running the logger.
/data/spreads

# Guard values changed from the desk at runtime. `config/default.toml` is
# the file a person edits and a commit records; this is the layer the desk
# took over, and committing it would make two files claim the same authority.
/config/guards.toml

# Deploy kit output - the zip is a build artefact, not source.
/deploy/flowdesk-*.zip
# The staged pair, same argument as the zip. AND a correctness one: pack.ps1
# used to create this INSIDE the repo and then ask git whether the tree was
# dirty, so every VERSION said git_dirty=true and the flag stopped meaning
# anything. Worse, a leftover folder from the previous pack was present when
# cargo ran, so build.rs baked dirty=true into the BINARY - the value the
# deploy actually acts on. Ignoring it fixes the propagation; pack.ps1 also
# now measures before it writes anything.
/deploy/staged-*
# install-tasks.ps1 -Apply exports each live task's XML here before replacing
# it. Rollback material, per-machine, and not source - and it dirtied the
# tree the same way.
/deploy/task-backup-*

# The sealed research store: a truncated copy of data/ built by seal-store for
# design agents that must not see the withheld year. Derived, large, rebuildable.
/data-sealed
